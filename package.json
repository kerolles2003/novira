{
  "name": "novira-theme-tailwind",
  "version": "1.0.0",
  "description": "Tailwind stabilization build for Novira theme",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/tailwind-source.css -o ./assets/css/tailwind-compiled.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/tailwind-source.css -o ./assets/css/tailwind-compiled.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^3.4.1"
  }
}
