#: inc/diploma.php:78 template-parts/sections/premium-exam/journey.php:40
msgid "التأسيس"
msgstr ""

#: inc/diploma.php:79
msgid "بناء أساس أكاديمي ولغوي متين قبل الدخول في متطلبات الدبلومة الأمريكية."
msgstr ""

#: inc/diploma.php:80
msgid "تحديد المستوى وبناء المهارات الأساسية في اللغة الإنجليزية والمواد الدراسية."
msgstr ""

#: inc/diploma.php:89
msgid "المتابعة الأكاديمية"
msgstr ""

#: inc/diploma.php:90
msgid "متابعة مستمرة عبر سنوات الدراسة بدلاً من التحضير لاختبار واحد."
msgstr ""

#: inc/diploma.php:91
msgid "متابعة دورية للتقدّم الأكاديمي مع معلمين متخصصين."
msgstr ""

#: inc/diploma.php:100
msgid "الكورسات المتخصصة"
msgstr ""

#: inc/diploma.php:101
msgid "إتقان محتوى المواد ومهارات اللغة الإنجليزية المطلوبة للمنهج الأمريكي."
msgstr ""

#: inc/diploma.php:102
msgid "تدريس المواد المتخصصة من خلال معلمين متخصصين."
msgstr ""

#: inc/diploma.php:111
msgid "الإعداد للاختبار الدولي والاختبارات التجريبية"
msgstr ""

#: inc/diploma.php:112
msgid "قياس الجاهزية للاختبار الدولي المناسب (EST أو Digital SAT أو ACT)."
msgstr ""

#: inc/diploma.php:113
msgid "إعداد موجّه لكل اختبار، واختبارات تجريبية تكشف نقاط الضعف وتحسّنها قبل الموعد."
msgstr ""

#: inc/diploma.php:123 template-parts/sections/exam/s5-registration.php:30
msgid "دعم التسجيل"
msgstr ""

#: inc/diploma.php:124
msgid "تنظيم التسجيل والمواعيد ومتطلبات يوم الاختبار."
msgstr ""

#: inc/diploma.php:125
msgid "ندعم إجراءات التسجيل والجدولة، والتنسيق اللوجستي عند الحاجة — لتخفيف العبء عن الأسرة."
msgstr ""

#: inc/diploma.php:135
msgid "الامتحان الرسمي وأفضل درجة ممكنة"
msgstr ""

#: inc/diploma.php:136
msgid "دخول الاختبار مستعداً فعلاً وتحقيق أفضل درجة ممكنة."
msgstr ""

#: inc/diploma.php:137
msgid "يدخل طالبك الاختبار وقد تدرّب على بيئته في الاختبارات التجريبية، ونستمر معه لإعادته وتحسين درجته إن رغب."
msgstr ""

#: inc/diploma.php:147
msgid "بعد الاختبار: إرشاد التقديم الجامعي (اختياري)"
msgstr ""

#: inc/diploma.php:148
msgid "فهم خطوات التقديم للجامعات بعد الحصول على الدرجة."
msgstr ""

#: inc/diploma.php:149
msgid "إرشاد اختياري خلال خطوات التقديم، مع خضوع قرارات ومتطلبات القبول لسياسات الجامعات والجهات المختصة."
msgstr ""

#: inc/diploma.php:263
msgid "ما المرحلة الدراسية التي يرافق فيها البرنامج الطالب؟"
msgstr ""

#: inc/diploma.php:264
msgid "يرافق برنامج الدبلومة الأمريكية الطالب من الصف العاشر حتى الصف الثاني عشر (Grade 10 – Grade 12)."
msgstr ""

#: inc/diploma.php:267
msgid "ما الاختبارات الدولية التي تُعِدّون لها؟"
msgstr ""

#: inc/diploma.php:268
msgid "نُعِدّ الطلاب لاختبارات EST و Digital SAT و ACT. (برنامج AP غير متاح حالياً.)"
msgstr ""

#: inc/diploma.php:271
msgid "كيف تتم المتابعة الأكاديمية للطالب؟"
msgstr ""

#: inc/diploma.php:272
msgid "يتابع فريق نوفيرا تقدّم الطالب أكاديمياً خلال مراحل الدبلومة الأمريكية من خلال معلمين متخصصين. تُحدَّد آلية المتابعة الدقيقة حسب البرنامج — تواصل معنا للتفاصيل."
msgstr ""

#: inc/diploma.php:276
msgid "هل تساعدون في إجراءات التسجيل للاختبارات؟"
msgstr ""

#: inc/diploma.php:277
msgid "نعم، نقدّم الدعم في إجراءات التسجيل والجدولة ومتطلبات يوم الاختبار لاختبارات EST و Digital SAT و ACT."
msgstr ""

#: inc/diploma.php:280
msgid "هل تقدّمون إرشاداً للتقديم الجامعي؟"
msgstr ""

#: inc/diploma.php:281
msgid "نعم، نقدّم إرشاداً خلال خطوات التقديم الجامعي. وتظل متطلبات وقرارات القبول خاضعة لسياسات الجامعات والجهات المختصة."
msgstr ""

#: inc/diploma.php:285
msgid "هل تضمنون القبول الجامعي أو المنح الدراسية؟"
msgstr ""

#: inc/diploma.php:289
msgid "كيف يمكن متابعة مستوى تقدّم الطالب؟"
msgstr ""

#: inc/diploma.php:290
msgid "يوفّر فريق نوفيرا متابعة لمستوى الطالب أثناء البرنامج. لمعرفة طريقة وتكرار مشاركة تقارير التقدّم تواصل معنا."
msgstr ""

#: inc/diploma.php:294
msgid "كيف تتواصلون مع أولياء الأمور؟"
msgstr ""

#: inc/diploma.php:295
msgid "نوفّر تواصلاً مع أولياء الأمور حول مسار الطالب. تُحدَّد طريقة وتكرار التواصل حسب البرنامج — تواصل معنا للتفاصيل."
msgstr ""

#: inc/diploma.php:338
msgid "برنامج الدبلومة الأمريكية"
msgstr ""

#: inc/diploma.php:346
msgid "برنامج يرافق الطالب خلال مسار الدبلومة الأمريكية من الصف العاشر حتى الصف الثاني عشر، ويشمل المتابعة الأكاديمية والكورسات المتخصصة والاستعداد لاختبارات EST و Digital SAT و ACT والدعم اللوجستي للاختبارات وإرشاد التقديم الجامعي. "
msgstr ""

